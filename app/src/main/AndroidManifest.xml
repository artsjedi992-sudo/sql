<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Декларира достъп до камерата за оптичния тахометър и скенера. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Позволява запис на звук за акустичния тахометър; заявява се и по време на работа. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Декларира системно разрешение или компонент, необходим на приложението. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Декларира системно разрешение или компонент, необходим на приложението. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <application
        android:allowBackup="false"
        android:label="Database Browser"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">
        <!-- Декларира системно разрешение или компонент, необходим на приложението. -->
        <activity android:name=".ScannerActivity" android:exported="false" />
        <!-- Регистрира оптичния тахометър, който анализира изображението от камерата. -->
        <activity android:name=".TachometerActivity" android:exported="false" />
        <!-- Регистрира акустичния тахометър, който анализира звука и FFT спектъра. -->
        <activity android:name=".AcousticTachometerActivity" android:exported="false" />
        <!-- Декларира системно разрешение или компонент, необходим на приложението. -->
        <activity android:name=".CarDynoActivity" android:exported="false" />
        <!-- Декларира системно разрешение или компонент, необходим на приложението. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Декларира системно разрешение или компонент, необходим на приложението. -->
            <intent-filter>
                <!-- Декларира системно разрешение или компонент, необходим на приложението. -->
                <action android:name="android.intent.action.MAIN" />
                <!-- Декларира системно разрешение или компонент, необходим на приложението. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
